# Tour request email, sent by /api/tour when a family submits the form.
# Copy to .env.local and fill in. Never commit the filled-in file.

# From the Resend dashboard: API Keys -> Create API Key (sending permission).
# Without this the form refuses to submit rather than pretending it worked.
RESEND_API_KEY=

# The two settings below are optional. The route already defaults to exactly
# these values, so a local .env.local usually needs only the key above.

# Who the notification appears to come from. Resend only sends as a domain it
# has verified. send.ptltreehouse.com was verified on 2026-09-23, so this
# address works in every environment and needs no override.
TOUR_FROM_EMAIL="PTL Treehouse <tours@send.ptltreehouse.com>"

# Where tour requests land. Defaults to contactInfo.email when unset.
# Point this at your own address if you are testing, so that a trial run does
# not reach the school's real inbox.
TOUR_TO_EMAIL=info@ptltreehouse.com
