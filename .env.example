# Tour request email, sent by /api/tour when a family submits the form.
# Copy to .env.local and fill in. Never commit the filled-in file.

# From the Resend dashboard: API Keys -> Create API Key (sending permission).
# Without this the form refuses to submit rather than pretending it worked.
RESEND_API_KEY=

# Who the notification appears to come from. Resend only sends as a domain it
# has verified, so this stays on send.ptltreehouse.com once the DNS records
# are in place.
#
# Before the domain is verified, use Resend's test sender instead:
#   TOUR_FROM_EMAIL=onboarding@resend.dev
# It needs no DNS, but it will only deliver to the address on the Resend
# account, so set TOUR_TO_EMAIL to that address while testing.
TOUR_FROM_EMAIL="PTL Treehouse <tours@send.ptltreehouse.com>"

# Where tour requests land. Defaults to contactInfo.email when unset.
TOUR_TO_EMAIL=info@ptltreehouse.com
